#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
//새로운 헤더파일
#include <ctype.h>

int my_strcmp(char *p1, char *p2)
{
    int size, i=0;
    char c1, c2;
    
    size=strlen(p1);
    if(size>strlen(p2)){
        size=strlen(p2);
    }
    
    for(i=0 ; i<size ; i++){
        c1=tolower(p1[i]);
        c2=tolower(p2[i]);
        
        if(c1!=c2){
            if(c1-c2>0)
                return 1;
            if(c1-c2<0)
                return -1;
        }
    }
    
    if(strlen(p1)>strlen(p2))
        return 1;
        
    if(strlen(p1)<strlen(p2))
        return -1;
        
    return 0;
}

void make_dictionary(char **p, int count)
{
    int i, j;
    char *temp;
    
    //선택정렬
    for(i=0; i<count-1; i++){
        for(j=i+1; j<count; j++){
            
            if(my_strcmp(p[i], p[j])>0){
                temp=p[j];
                p[j]=p[i];
                p[i]=temp;
            }
        }
    }
}

int main()
{
    FILE *rfp;
    FILE *wfp;
    char arr[100];
    char *words[50];
    char *token;
    int count=0;
    int i;
    
    rfp=fopen("words.txt", "r");
    if(rfp==NULL){
        printf("파일 열기 실패");
        return 1;
    }
    
    while(fgets(arr, 100, rfp) != NULL){
        //strtok 개념 복습하기
        token=strtok(arr, " ,|\t;\n\r");
        //메모자은 \r도 신경써야 함;;; 그지같네
        while(token!=NULL){
            words[count]=(char*)malloc((sizeof(char)*strlen(token))+1);  
            strcpy(words[count], token);
            count++;
            
            token=strtok(NULL, " ,|\t;\n\r");
        }
    }
    
    
    make_dictionary(words, count);
    
    wfp=fopen("dictionary.txt", "w");
    if(wfp==NULL){
        printf("파일 열기 실패");
        return 1;
    }
    
    for(i=0; i<count; i++){
        fprintf(wfp, "%s\n", words[i]);
    }

    fclose(wfp);
    fclose(rfp);
    
    for(i=0; i<count; i++){
        free(words[i]);
    }
    
    

    return 0;
}
