#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <string.h>
#include <stdlib.h>

int main()
{
    int i, dan;
    FILE *wfp;
    char arr[15]="1_dan.txt";
    
    printf("출력하고 싶은 단을 입력: ");
    scanf("%d", &dan);
    if(dan<1 || dan>9){
        printf("1~9단을 입력해주세요");
        return 1;
    }
    
    sprintf(arr, "%d_dan.txt", dan);
    
    wfp=fopen(arr, "w");
    if (wfp == NULL) {
    printf("파일 열기 실패!\n");
    return 1;
    }
    
    for(i=0; i<9; i++){
        fprintf(wfp, "%d X %d = %d\n", dan, i+1, dan*(i+1));
    }
    
    printf("%d_dan.txt에 결과를 저장", dan);
    fclose(wfp);
    return 0;
}
