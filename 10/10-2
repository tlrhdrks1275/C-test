#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <string.h>
#include <stdlib.h>


struct drink{
        char drink_name[20];
        float drink_price;
    };

struct dessert{
        char dessert_name[20];
        float dessert_price;
    };

struct receipt {
        char menu[20];
        float price;
        int menu_num;
    };

void initial_menulist(struct drink *a, struct dessert *b)
{
    FILE *rfp1;
    FILE *rfp2;
    int i;
    
    rfp1=fopen("drink.txt", "r");
    if(rfp1==NULL){
        printf("drink.txt 읽기 실패");
        return;
    }
    for(i=0; i<5; i++){
        fscanf(rfp1, "%s %f", a[i].drink_name, &a[i].drink_price);
    }
    
    rfp2=fopen("dessert.txt", "r");
    if(rfp2==NULL){
        printf("dessert.txt 읽기 실패");
        return;
    }
    for(i=0; i<5; i++){
        fscanf(rfp2, "%s %f", b[i].dessert_name, &b[i].dessert_price);
    }
    
}

