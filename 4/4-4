#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int main()
{
    int i, j, size, c=0;
    char *p[3];
    char isml[100];
    
    
    
    for(i=0; i<2; i++)
    {
        printf("%d 번째 문자열: ", i+1);
        gets(isml);
        size=strlen(isml);
        p[i]=(char*)malloc((sizeof(char)*size)+1);
        strcpy(p[i], isml);
        c=c+size;
    }
    
    p[2]=(char*)malloc((sizeof(char)*c)+1);
    p[2][0]='\0';
    
    strcat(p[2], p[0]);
    strcat(p[2], p[1]);
    
    for(i=0; i<3; i++)
    {
        printf("\n%d번: %s", i+1, p[i]);
    }
    
    
    for (i = 0; i < 3; i++) {
        free(p[i]);
    }
    
    return 0;
}
