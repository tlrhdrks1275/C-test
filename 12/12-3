#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <string.h>
#include <stdlib.h>

struct node
{
    int num;
    struct node *prev;
    struct node *next;
};

struct node *create_node(int num)
{
    struct node* new_node=malloc(sizeof(struct node));
    new_node->num=num;
    
    new_node->prev=NULL;
    new_node->next=NULL;
    
    return new_node;
}

struct node *insert_node(struct node *head, int num)
{
    struct node *new_node=create_node(num);
    if(head==NULL){
        head=new_node;
    }
    
    else{
        struct node* temp=head;
        while(temp->next!=NULL){
            temp=temp->next;
        }
        temp->next=new_node;
        new_node->prev=temp;
    }
    return head;
}

struct node* delete_node(struct node *head, int target)
{
    struct node* current=head;
    
    if(current != NULL && current->num==target){
        if(head->next==NULL){
            free(head);
            head=NULL;
            return head;
        }
        
        head=current->next;
        head->prev=NULL;
        free(current);
        return head;
    }
    
    while(current!=NULL && current->num!=target){
        current=current->next;
    }
    
    if(current==NULL){
        printf("\n삭제할 노드가 없습니다\n");
        return head;
    }
    
    if(current->next==NULL){
        current->prev->next=NULL;
        free(current);
        return head;
    }
    
    current->prev->next=current->next;
    current->next->prev=current->prev;
    free(current);
    return head;
}


int main()
{
    int i, num;
    struct node *head=NULL;
    
    for( ; ; ){
        printf("숫자를 입력해주세요(0은 종료): ");
        scanf("%d", &num);
        
        if(num==0){
            struct node *temp=head;
            printf("입력한 값들: ");
            while(temp!=NULL){
                printf("%d ", temp->num);
                temp=temp->next;
            }
            return 0;
        }
        
        if(num<0){
            head=delete_node(head, -num);
        }
        
        if(num>0){
            head=insert_node(head, num);
        }
    }

    return 0;
}
