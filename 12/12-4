#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

struct node{
    int num;
    struct node *next;
    struct node *prev;
};

struct node* create_node(int num)
{
    struct node* new_node=malloc(sizeof(struct node));
    new_node->num=num;
    
    new_node->next=NULL;
    new_node->prev=NULL;
    
    return new_node;
}

struct node* insert_odd_node(struct node* head, int num)
{
    struct node* new_node=create_node(num);
    if(head==NULL){
        head=new_node;
    }
    
    else{
        struct node* temp=head;
        while(temp->next!=NULL){
            temp=temp->next;
        }
        temp->next=new_node;
        new_node->prev=temp;
        
    }
    return head;
    
}

struct node* insert_even_node(struct node* head, int num)
{
    struct node* new_node=create_node(num);
    if(head==NULL){
        head=new_node;
    }
    
    else{
        struct node* temp=head;
        while(temp->prev!=NULL){
            temp=temp->prev;
        }
        temp->prev=new_node;
        new_node->next=temp;
    }
    return head;
}


int main()
{
    int num=1;
    int i;
    struct node* head=NULL;
    
    while(1){
        printf("숫자를 입력해 주세요: ");
        scanf("%d", &num);
        
        if(num==0){
            struct node* temp=head;
            if(temp->num%2==0){
                temp=temp->next;
            }
            printf("\n입력한 홀수들: ");
            while(temp!=NULL){
                printf("%d ", temp->num);
                temp=temp->next;
            }
            
            temp=head;
            if(temp->num%2==1){
                temp=temp->prev;
            }
            printf("\n입력한 짝수들: ");
            while(temp!=NULL){
                printf("%d ", temp->num);
                temp=temp->prev;
            }
            break;
        }
        
        if(num%2!=0){
            head=insert_odd_node(head, num);
        }
        
        if(num%2==0){
            head=insert_even_node(head, num);
        }
        
    }
    return 0;
}
