#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <string.h>
#include <stdlib.h>

struct node
{
    int num;
    struct node *next;
};

struct node *create_node(int data){
    struct node *new_node=malloc(sizeof(struct node));
    new_node->num=data;
    new_node->next=NULL;
    
    return new_node;
    
}

struct node *insert_node(struct node *head, int data)
{
    struct node *new_node=create_node(data);
    if(head==NULL){
        head=new_node;
    }
    
    else{
        struct node *temp=head;
        while(temp->next !=NULL){
            temp=temp->next;
        }
        temp->next=new_node;
    }
    return head;
}

int main()
{
    int i, num;
    struct node *head=NULL;
    
    for( ; ; ){
        printf("숫자를 입력해주세요(0은 종료): ");
        scanf("%d", &num);
        
        if(num==0){
            struct node *temp=head;
            printf("입력한 값들: ");
            while(temp!=NULL){
                printf("%d ", temp->num);
                temp=temp->next;
            }
            return 0;
        }
        
        head=insert_node(head, num);
    }

    return 0;
}
