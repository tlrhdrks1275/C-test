#define _CRT_SECURE_NO_WARNINGS
#include <stdlib.h>
#include <stdio.h>


int main()
{
    int n, i;
    struct students {
        char name[15];
        int age;
    };
    
    printf("입력할 학생 수: ");
    scanf("%d", &n);
    
    struct students *s=(struct students*)malloc(sizeof(struct students)*n);
    if(s==NULL){
        printf("메모리 할당 실패");
        return 1;
    }
    
    for(i=0; i<n; i++){
        printf("이름과 나이를 입력: ");
        scanf(" %s %d", s[i].name, &s[i].age);
    }
    
    printf("\n--학생 명단--\n");
    for(i=0; i<n; i++){
        printf("이름:%s, 나이:%d\n", s[i].name, s[i].age);
    }
    
    return 0;
}
