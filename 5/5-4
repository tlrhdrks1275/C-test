#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int main()
{
    int i=0, a, len=0;
    int values []={1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1};
    char *symbols[]={"M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"};
    char *p=(char*)calloc(1, sizeof(char));
    
    printf("숫자를 입력하세요(1000이하): ");
    scanf("%d", &a);

    while(1){
        if(a>=values[i]){
            
            a=a-values[i];
            len+=strlen(symbols[i]);
            p=(char*)realloc(p, (sizeof(char)*len)+1);
            strcat(p, symbols[i]);
        }
        
        else{
            i++;
        }
        
        if(a==0)
            break;
    }
    
    printf("\n%s, %d", p, len);

    free(p);
    return 0;
}
