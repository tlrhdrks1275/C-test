#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int main()
{
    int i, j, n, len, max_len=0;
    char arr[100];
    
    printf("입력할 문자열의 개수: ");
    scanf("%d", &n);
    
    char **p=(char**)malloc((sizeof(char*)*n));
    
    for(i=0; i<n; i++)
    {
        printf("문자열 입력: ");
        scanf(" %[^\n]s", arr);
        
        len=strlen(arr);
        if(max_len<len)
            max_len=len;
        
        p[i]=(char*)malloc((sizeof(char)*len)+1);
        strcpy(p[i], arr);
    }
    printf("\n");
    
    for(i=0; i<max_len; i++)
    {
        for(j=0; j<n; j++)
        {
            if(strlen(p[j])>i){
                printf("%c", p[j][i]);
            }
        }
    }
    
    for(i=0; i<n; i++)
    {
        free(p[i]);
    }
    free(p);
    
    return 0;
}
