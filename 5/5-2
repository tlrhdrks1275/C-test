#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

void my_strcmp(char *p1, char *p2)
{
    int i=0;
    int size, size2;
    size=strlen(p1);
    for(i=0; i<size; i++)
    {
        if(p1[i]>='A' && p1[i]<='Z')
            p1[i]+=32;
    }
    
    size2=strlen(p2);
    for(i=0; i<size2; i++)
    {
        if(p2[i]>='A' && p2[i]<='Z')
            p2[i]+=32;
    }
    
    if(size2!=size){
        printf("\nFalse");
        return;
    }
    
    for(i=0; i<size; i++)
    {
        if(p1[i]!=p2[i]){
            printf("\nFalse");
            return;
        }
    }
    
    printf("\nTrue");
    return;
    
}

int main()
{
    char *p[2];
    char arr[100];
    int i, size;
    
    for(i=0; i<2; i++)
    {
        printf("문자열을 입력해주세요: ");
        scanf(" %[^\n]s", arr);
        size=strlen(arr);
        p[i]=(char*)malloc((sizeof(char)*size)+1);
        p[i][0]='\0';
        strcat(p[i], arr);
    }
    
    my_strcmp(p[0], p[1]);
    
    for(i=0; i<2; i++)
    {
        free(p[i]);
    }
    
    return 0;
}
