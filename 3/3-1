#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <string.h>


int my_strcmp(char *p1, char *p2)
{
    int i=0;
    while((p1[i]!='\0') && (p2[i]!='\0'))
    {
            if(p1[i]>p2[i])
            return 1;
            
            if(p1[i]<p2[i])
            return -1;
            
        i++;
    }
    

        if(p1[i]>p2[i])
        return 1;
        
    else if(p1[i]<p2[i])
        return -1;
    return 0;
}

void my_strcat(char *p1, char *p2, char *p3)
{
    
    int i=0;
    int k;
    while(p1[i]!='\0')
    {
        p3[i]=p1[i];
        i++;
    }
    
    k=i;
    i=0;
    while(p2[i]!='\0')
    {
        p3[k]=p2[i];
        i++;
        k++;
    }
    
    p3[k]='\0';
    
}

void my_strcpy(char*p1, char*p2)
{
    int i=0;
    
    while(p1[i]!='\0')
    {
        p2[i]=p1[i];
        i++;
    }
    p2[i]='\0';
}

int main()
{
    char str1[6]="";
    char str2[6]=""; 
    char arr[15]="";
    int a;
    
    printf("영어 단어를 입력(5글자 이내): ");
    scanf("%s", str1);
    printf("영어 단어를 입력(5글자 이내): ");
    scanf(" %s", str2);
    
    a=my_strcmp(str1, str2);
    printf("\n\n반환값: %d", a);
    my_strcat(str1, str2, arr);
    printf("\n반환값: %s", arr);
    arr[0]='\0';
    my_strcpy(str1, arr);
    printf("\n반환값: %s", arr);
    
    return 0;
} 
