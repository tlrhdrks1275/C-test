#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>

int vip_check(int *vip, int count)
{
    int needed_rooms=(count+3)/4;
    int empty_rooms =0;
    int i;
    
    //빈방 세기
    for(i=0; i<3; i++)
    {
        if(vip[i]==0) 
            empty_rooms++;
    }
    
    if (empty_rooms < needed_rooms) 
    {
        printf("\n[실패] VIP 룸이 부족합니다. (필요: %d개, 가능: %d개)\n", needed_rooms, empty_rooms);
        return 0;
    }
    
    // 예약 진행 (방 채우기)
    printf("\n[성공] VIP 룸 예약 성공! 배정된 방: ");
    for (i = 0; i < 3 && needed_rooms > 0; i++) 
    {
        if (vip[i] == 0) 
        {
            vip[i] = 1; // 예약 완료 표시
            printf("%d호 ", 301 + i);
            needed_rooms--;
        }
    }
    printf("\n");
    return 1;
}

int normal_check(int *normal, int count) {
    // 1개 방당 2명 수용 가능
    int needed_rooms = (count + 1) / 2;
    int empty_rooms = 0;
    int i;

    for (i = 0; i < 5; i++) {
        if (normal[i] == 0) empty_rooms++;
    }

    if (empty_rooms < needed_rooms) {
        printf("\n[실패] 일반 룸이 부족합니다. (필요: %d개, 가능: %d개)\n", needed_rooms, empty_rooms);
        return 0;
    }

    printf("\n[성공] 일반 룸 예약 성공! 배정된 방: ");
    for (i = 0; i < 5 && needed_rooms > 0; i++) {
        if (normal[i] == 0) {
            normal[i] = 1;
            printf("%d호 ", 201 + i);
            needed_rooms--;
        }
    }
    printf("\n");
    return 1;
}

void reservation_hotel(int room, int n, int *vip, int *normal)
{
    if(room==1)
    {
        vip_check(vip, n);
    }
    else if(room==2)
    {
        normal_check(normal, n);
    }
}

int main()
{
    int vip_rooms[3]={0};  
    int normal_rooms[5]={0};
    //빈 방은 0, 예약됨은 1
    int room, n, i;
    
    for(i=0; i<5; i++)
    {
     printf("\n--- [%d번째 예약 요청]---\n", i+1);
     while(1)
     {
        printf("예약 룸을 선택해 주세요(VIP: 1, Normal: 2): ");
        scanf("%d", &room);
        if(room==1 || room==2)
            break;
        
        printf("잘못 입력하셨습니다. 다시 입력해주세요!\n");
     }
     
     printf("예약 인원을 입력해주세요: ");
     scanf("%d", &n);
     
    reservation_hotel(room, n, vip_rooms, normal_rooms);
     
    }
    return 0;
}
